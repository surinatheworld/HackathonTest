# Cloudflare Pages headers.
# The page and the contract addresses must never be cached, so a fresh `npm run deploy:gasless` + push
# reaches players immediately.
/
  Cache-Control: no-cache
/prototype/chain-config.js
  Cache-Control: no-cache
/prototype/chain.js
  Cache-Control: no-cache

# Nobody may frame the game (clickjacking the "sign" buttons).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
