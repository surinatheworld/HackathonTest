# Testnet-only keys. Run `npm run wallet` to generate them; never put a mainnet key here.
PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Fuji C-Chain (default public RPC works)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Your Game L1 from Builder Console → My L1 Dashboard
L1_RPC_URL=
L1_CHAIN_ID=
L1_NAME=Farm L1
L1_TOKEN_SYMBOL=FARM
# Optional: public RPC/explorer shown to players if different from L1_RPC_URL
L1_PUBLIC_RPC_URL=
L1_EXPLORER_URL=

# Seconds per game day. 60 makes a 7-day crop ripen in 7 minutes for demos.
DAY_LENGTH=60

# Optional: key for scripts/relayer.js (defaults to PRIVATE_KEY). Needs AVAX on Fuji and gas on the L1.
RELAYER_PRIVATE_KEY=
